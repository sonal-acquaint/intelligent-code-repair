{
    "name": "acquaint/laravel-ai-bug-fixer",
    "description": "AI-powered bug detection and fixing for Laravel applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Acquaint\\LaravelAiBugFixer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acquaint\\LaravelAiBugFixer\\BugFixerServiceProvider"
            ]
        }
    }
}
